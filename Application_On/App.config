<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>

  <appSettings>
    <!-- 
      Relative path: VTS_TCP.exe must be in the SAME folder as Application_On.exe
      OR use a full absolute path like: C:\VTS\VTS_TCP.exe
      The app name may have changed — update this to match your published exe name.
    -->
    <add key="openApp_Path" value="D:\Data_Collector\Data_Collector_App\FX_TCP.exe"/>

    <!-- Seconds to wait before launching the main app -->
    <add key="Restart_Second" value="15"/>
  
  </appSettings>
  
</configuration>